{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://*.shopify.com https://*.myshopify.com https://admin.shopify.com;"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/webhooks/:path*", "destination": "/api/webhook" },
    { "source": "/auth/:path*",     "destination": "/api/webhook" }
  ]
}
